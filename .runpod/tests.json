{
  "tests": [
    {
      "name": "comfyui_readiness",
      "input": {
        "healthcheck": true
      },
      "timeout": 1800000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA L40S",
    "gpuCount": 1,
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0"
    ],
    "env": [
      {
        "key": "HF_TOKEN",
        "value": "{{ RUNPOD_SECRET_HUGGINGFACE_TOKEN }}"
      },
      {
        "key": "HF_HOME",
        "value": "/workspace/.cache/huggingface"
      },
      {
        "key": "MODEL_MODE",
        "value": "both"
      },
      {
        "key": "STUDIO_VERSION",
        "value": "4"
      },
      {
        "key": "PORT",
        "value": "8000"
      },
      {
        "key": "PORT_HEALTH",
        "value": "8001"
      },
      {
        "key": "COPYPARTY_USERNAME",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_USERNAME }}"
      },
      {
        "key": "COPYPARTY_PASSWORD",
        "value": "{{ RUNPOD_SECRET_COPYPARTY_SECRET }}"
      }
    ]
  }
}
